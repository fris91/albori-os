{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/lists/**",
              "components/system/**",
              "ui_kits/albori-os/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bodoni Moda|Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Bodoni Moda, Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:app|icon|label|size|variant|showLabel|badge|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AppIcon> doesn't accept that prop. Declared props: app, icon, label, size, variant, showLabel, badge, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIcon'] > JSXAttribute[name.name='app'] > Literal[value!=/^(?:telefono|messaggi|browser|fotocamera|galleria|file|impostazioni|calendario|orologio|mappe|contatti|email|musica|note|store|sicurezza)$/]",
        "message": "<AppIcon> app must be one of 'telefono' | 'messaggi' | 'browser' | 'fotocamera' | 'galleria' | 'file' | 'impostazioni' | 'calendario' | 'orologio' | 'mappe' | 'contatti' | 'email' | 'musica' | 'note' | 'store' | 'sicurezza'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIcon'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:auto|grafite|porcellana|alba|contorno)$/]",
        "message": "<AppIcon> variant must be one of 'auto' | 'grafite' | 'porcellana' | 'alba' | 'contorno'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|count|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, count, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|success|warning|danger|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'success' | 'warning' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|icon|iconRight|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, icon, iconRight, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|icon|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, icon, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|filled|glass|accent)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'filled' | 'glass' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<IconButton> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:inset|children|key|ref|className|style|children)$/]",
        "message": "<ListGroup> doesn't accept that prop. Declared props: inset, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|leading|title|subtitle|value|chevron|trailing|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, leading, title, subtitle, value, chevron, trailing, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|onBack|onHome|onRecents|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: mode, onBack, onHome, onRecents."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:gesture|buttons)$/]",
        "message": "<NavBar> mode must be one of 'gesture' | 'buttons'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:app|appName|time|title|text|hidden|count|solid|onClick|children|key|ref|className|style|children)$/]",
        "message": "<NotificationCard> doesn't accept that prop. Declared props: app, appName, time, title, text, hidden, count, solid, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|accent|motion|textScale|children|style|key|ref|className|style|children)$/]",
        "message": "<PhoneFrame> doesn't accept that prop. Declared props: theme, accent, motion, textScale, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<PhoneFrame> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:sole|corallo|salvia|adriatico)$/]",
        "message": "<PhoneFrame> accent must be one of 'sole' | 'corallo' | 'salvia' | 'adriatico'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute[name.name='motion'] > Literal[value!=/^(?:reduced)$/]",
        "message": "<PhoneFrame> motion must be one of 'reduced'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|stateLabel|active|onToggle|onDetails|compact|key|ref|className|style|children)$/]",
        "message": "<QuickToggle> doesn't accept that prop. Declared props: icon, label, stateLabel, active, onToggle, onDetails, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|children|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, onChange, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|glass|onClear|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, glass, onClear, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|action|onAction|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: children, action, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|icon|variant|showValue|label|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, onChange, icon, variant, showValue, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fill|thin)$/]",
        "message": "<Slider> variant must be one of 'fill' | 'thin'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|battery|charging|privacy|silent|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: time, battery, charging, privacy, silent."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute[name.name='privacy'] > Literal[value!=/^(?:camera|mic|location)$/]",
        "message": "<StatusBar> privacy must be one of 'camera' | 'mic' | 'location'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wallpaper'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|dim|key|ref|className|style|children)$/]",
        "message": "<Wallpaper> doesn't accept that prop. Declared props: variant, dim."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wallpaper'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:alba|foschia|ossidiana)$/]",
        "message": "<Wallpaper> variant must be one of 'alba' | 'foschia' | 'ossidiana'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
