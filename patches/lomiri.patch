@@ -0,0 +1,63 @@
+import QtQuick 2.15
+import ".." as UI
+
+Item {
+    id: page
+    property var os
+    UI.TextLabel { x: 20; y: 14; text: "App recenti"; size: 25; font.weight: Font.DemiBold }
+    UI.TextLabel { x: 20; y: 48; width: parent.width - 40; text: "Le app restano pronte in memoria per un accesso rapido"; size: 12; color: UI.Style.muted; wrapMode: Text.Wrap }
+
+    ListView {
+        id: cards; x: 0; y: 82; width: parent.width; height: parent.height - 148
+        orientation: ListView.Horizontal; spacing: 14; clip: true
+        model: page.os ? os.recentApps : []
+        preferredHighlightBegin: (width - 250) / 2; preferredHighlightEnd: preferredHighlightBegin + 250
+        highlightRangeMode: ListView.StrictlyEnforceRange; snapMode: ListView.SnapOneItem
+        header: Item { width: Math.max(0, (cards.width - 250) / 2); height: 1 }
+        footer: Item { width: Math.max(0, (cards.width - 250) / 2); height: 1 }
+        delegate: Item {
+            id: task; width: 250; height: cards.height
+            property string appKey: modelData
+            Column {
+                id: cardContent; width: parent.width; spacing: 10
+                Row {
+                    width: parent.width; spacing: 9
+                    UI.AppButton { appKey: task.appKey; tileSize: 30; showLabel: false }
+                    UI.TextLabel { anchors.verticalCenter: parent.verticalCenter; text: UI.Style.app(task.appKey).title; size: 14; font.weight: Font.Medium }
+                }
+                Rectangle {
+                    width: 250; height: Math.min(440, cards.height - 58); radius: 26
+                    color: UI.Style.bg; border.width: index === cards.currentIndex ? 2 : 1
+                    border.color: index === cards.currentIndex ? UI.Style.accent : UI.Style.hairline
+                    Column {
+                        x: 16; y: 16; width: parent.width - 32; spacing: 13
+                        Rectangle { width: parent.width; height: 34; radius: 12; color: UI.Style.surface2 }
+                        UI.TextLabel { text: UI.Style.app(task.appKey).title; size: 22; font.weight: Font.DemiBold }
+                        Repeater { model: [.72, 1, .86, 1, .58, .92, .76]; Rectangle { width: parent.width * modelData; height: 11; radius: 6; color: UI.Style.surface2 } }
+                    }
+                    MouseArea { anchors.fill: parent; onClicked: page.os.openApp(task.appKey) }
+                }
+            }
+            MouseArea {
+                anchors.fill: parent
+                drag.target: cardContent; drag.axis: Drag.YAxis
+                drag.minimumY: -cards.height; drag.maximumY: cards.height
+                onReleased: {
+                    if (Math.abs(cardContent.y) > 90) {
+                        dismiss.to = cardContent.y < 0 ? -cards.height : cards.height
+                        dismiss.start()
+                    } else rebound.start()
+                }
+            }
+            NumberAnimation { id: rebound; target: cardContent; property: "y"; to: 0; duration: UI.Style.duration; easing.type: Easing.OutCubic }
+            NumberAnimation { id: dismiss; target: cardContent; property: "y"; duration: 180; easing.type: Easing.InCubic; onStopped: page.os.closeRecent(task.appKey) }
+        }
+    }
+
+    UI.TextLabel { anchors.centerIn: parent; visible: page.os && os.recentApps.length === 0; text: "Nessuna app in memoria"; size: 17; color: UI.Style.muted }
+    UI.ActionButton {
+        anchors.horizontalCenter: parent.horizontalCenter; anchors.bottom: parent.bottom; anchors.bottomMargin: 12
+        text: "Cancella tutte"; icon: "x"; primary: false; visible: page.os && os.recentApps.length > 0
+        onClicked: os.recentApps = []
+    }
+}
